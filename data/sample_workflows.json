{
  "version": "1.0",
  "workflows": [
    {
      "workflow_id": "tpl_demo_client_intake",
      "name": "Starter: Demo Portal Client Intake",
      "description": "Portable starter profile using demo://index.html to dismiss the notice banner, fill the intake form, pause for approval, and extract the registration confirmation.",
      "target_url": "demo://index.html",
      "browser": "chrome",
      "is_template": true,
      "steps": [
        {
          "step_id": "step_intake_01",
          "name": "Open Demo Portal",
          "action_type": "open_url",
          "selector_strategy": "css",
          "selector_value": "",
          "input_value": "demo://index.html",
          "csv_column": "",
          "output_key": "",
          "condition": "always",
          "condition_target": "",
          "requires_approval": false,
          "timeout": 10.0,
          "max_retries": 2,
          "options": {}
        },
        {
          "step_id": "step_intake_02",
          "name": "Dismiss Notice Banner (If Present)",
          "action_type": "click_element",
          "selector_strategy": "id",
          "selector_value": "close-banner-btn",
          "input_value": "",
          "csv_column": "",
          "output_key": "",
          "condition": "skip_if_missing",
          "condition_target": "close-banner-btn",
          "requires_approval": false,
          "timeout": 5.0,
          "max_retries": 1,
          "options": {}
        },
        {
          "step_id": "step_intake_03",
          "name": "Enter Full Name",
          "action_type": "enter_text",
          "selector_strategy": "id",
          "selector_value": "full-name",
          "input_value": "Katherine Johnson",
          "csv_column": "",
          "output_key": "",
          "condition": "always",
          "condition_target": "",
          "requires_approval": false,
          "timeout": 10.0,
          "max_retries": 2,
          "options": {}
        },
        {
          "step_id": "step_intake_04",
          "name": "Enter Work Email",
          "action_type": "enter_text",
          "selector_strategy": "id",
          "selector_value": "email-address",
          "input_value": "katherine@orbital.org",
          "csv_column": "",
          "output_key": "",
          "condition": "always",
          "condition_target": "",
          "requires_approval": false,
          "timeout": 10.0,
          "max_retries": 2,
          "options": {}
        },
        {
          "step_id": "step_intake_05",
          "name": "Select Research Department",
          "action_type": "select_option",
          "selector_strategy": "id",
          "selector_value": "department-select",
          "input_value": "Research",
          "csv_column": "",
          "output_key": "",
          "condition": "always",
          "condition_target": "",
          "requires_approval": false,
          "timeout": 10.0,
          "max_retries": 2,
          "options": {
            "select_mode": "visible_text"
          }
        },
        {
          "step_id": "step_intake_06",
          "name": "Submit Intake Record",
          "action_type": "click_element",
          "selector_strategy": "id",
          "selector_value": "submit-btn",
          "input_value": "",
          "csv_column": "",
          "output_key": "",
          "condition": "always",
          "condition_target": "",
          "requires_approval": true,
          "timeout": 10.0,
          "max_retries": 2,
          "options": {}
        },
        {
          "step_id": "step_intake_07",
          "name": "Extract Registration Status",
          "action_type": "extract_text",
          "selector_strategy": "id",
          "selector_value": "status-badge",
          "input_value": "",
          "csv_column": "",
          "output_key": "registration_status",
